# Remit environment variables. Copy to .env and fill in. Never commit .env.
# See docs/configuration.md for details.

# Jev (TypeSafe)
TYPESAFE_API_KEY=
# Default extraction LLM
ANTHROPIC_API_KEY=
# Optional decorrelated extraction
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
# CLI and eval mining (a read-only fine-grained token is enough)
GITHUB_TOKEN=
# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
# Dashboard login
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Postgres
DATABASE_URL=postgres://remit:remit@localhost:5432/remit
# Webhook and setup URLs
PUBLIC_URL=http://localhost:3000
# Dashboard sessions
SESSION_SECRET=
# Encrypting stored app credentials
SECRETS_ENCRYPTION_KEY=
# Record-and-replay mode: live | record | replay | replay_or_live
REMIT_CACHE_MODE=replay_or_live
# Logging
REMIT_LOG_LEVEL=info
# Per eval run budget in USD
EVAL_MAX_USD=20
