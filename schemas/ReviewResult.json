{
  "$id": "urn:remit:schema:ReviewResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "product": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "github",
            "local"
          ]
        },
        "repo": {
          "type": "string"
        },
        "pr": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "baseSha": {
          "type": "string"
        },
        "headSha": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "owner",
              "repo",
              "number"
            ],
            "additionalProperties": false
          }
        },
        "linkStrength": {
          "type": "string",
          "enum": [
            "closing",
            "weak",
            "none"
          ]
        }
      },
      "required": [
        "mode",
        "baseSha",
        "headSha",
        "issues",
        "linkStrength"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "questionSet": {
          "type": "string",
          "pattern": "^qs-\\d+\\.\\d+\\.\\d+$"
        },
        "extractionPrompt": {
          "type": "string",
          "pattern": "^xp-\\d+\\.\\d+\\.\\d+$"
        },
        "jevModel": {
          "type": "string"
        },
        "llmModel": {
          "type": "string"
        },
        "calibration": {
          "type": "string"
        }
      },
      "required": [
        "questionSet",
        "extractionPrompt",
        "jevModel"
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(I\\d+\\.)?R\\d+$"
          },
          "issue": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "number": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "owner",
              "repo",
              "number"
            ],
            "additionalProperties": false
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "title",
                  "body",
                  "comment",
                  "tasklist"
                ]
              },
              "commentId": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": [
              "behavior",
              "constraint",
              "non_goal",
              "test",
              "docs",
              "config",
              "migration",
              "performance",
              "security",
              "ux"
            ]
          },
          "explicitness": {
            "type": "string",
            "enum": [
              "explicit",
              "implied"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could"
            ]
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "string"
                },
                "expected": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "input",
                "expected",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "checkableInCode": {
            "type": "boolean"
          },
          "signals": {
            "type": "object",
            "properties": {
              "ambiguous": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "checkable": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "ambiguous",
              "checkable"
            ],
            "additionalProperties": false
          },
          "openQuestion": {
            "type": "object",
            "properties": {
              "readings": {
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "readings"
            ],
            "additionalProperties": false
          },
          "supersededBy": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "issue",
          "text",
          "quote",
          "source",
          "kind",
          "explicitness",
          "priority",
          "examples",
          "checkableInCode"
        ],
        "additionalProperties": false
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^U\\d+$"
          },
          "file": {
            "type": "string"
          },
          "oldFile": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "ts",
              "tsx",
              "js",
              "py",
              "rs",
              "other"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "source",
              "test",
              "config",
              "docs",
              "ci",
              "build",
              "migration",
              "generated",
              "lockfile",
              "vendored",
              "binary",
              "asset"
            ]
          },
          "changeType": {
            "type": "string",
            "enum": [
              "added",
              "modified",
              "deleted",
              "renamed"
            ]
          },
          "symbol": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "function",
                  "method",
                  "class",
                  "module",
                  "block",
                  "test"
                ]
              },
              "startLine": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "kind",
              "startLine",
              "endLine"
            ],
            "additionalProperties": false
          },
          "lines": {
            "type": "object",
            "properties": {
              "new": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "old": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": [
              "new",
              "old"
            ],
            "additionalProperties": false
          },
          "patch": {
            "type": "string"
          },
          "judgeView": {
            "type": "string"
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "testTitles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contentHash": {
            "type": "string"
          },
          "tokenEstimate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "filtered": {
            "type": "string",
            "enum": [
              "lockfile",
              "generated",
              "formatting_only",
              "vendored",
              "binary"
            ]
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^X\\d+$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "assertion_removed",
                    "assertion_weakened",
                    "expected_value_changed",
                    "test_skipped",
                    "test_focused",
                    "test_deleted",
                    "snapshot_updated",
                    "tolerance_widened",
                    "retry_or_timeout_added",
                    "suppression_added",
                    "catch_broadened",
                    "threshold_lowered",
                    "ci_changed",
                    "dependency_added",
                    "public_api_changed",
                    "new_symbol_unreferenced",
                    "secret_like"
                  ]
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warn",
                    "high"
                  ]
                },
                "unitId": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "kind",
                "severity",
                "unitId",
                "detail"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "file",
          "language",
          "kind",
          "changeType",
          "lines",
          "patch",
          "judgeView",
          "contentHash",
          "tokenEstimate",
          "facts"
        ],
        "additionalProperties": false
      }
    },
    "requirementVerdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirementId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "done",
              "partial",
              "missing",
              "contradicted",
              "interpretation_mismatch",
              "uncertain",
              "preexisting",
              "deferred",
              "not_checkable"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "calibrated": {
            "type": "boolean"
          },
          "tested": {
            "type": "string",
            "enum": [
              "as_stated",
              "differently",
              "untested",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "unitId": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "unitId",
                "file",
                "lines",
                "probability"
              ],
              "additionalProperties": false
            }
          },
          "testEvidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "unitId": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "unitId",
                "file",
                "lines",
                "probability"
              ],
              "additionalProperties": false
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "call": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "choice",
                    "score",
                    "noul"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "probabilities": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "calibratedValue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "call",
                "question",
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "claimMismatch": {
            "type": "object",
            "properties": {
              "sentence": {
                "type": "string"
              }
            },
            "required": [
              "sentence"
            ],
            "additionalProperties": false
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "template": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "template",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "requirementId",
          "status",
          "confidence",
          "calibrated",
          "tested",
          "evidence",
          "testEvidence",
          "answers",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "unitVerdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unitId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "implements",
              "supporting",
              "unexplained_behavioral",
              "unexplained_benign",
              "ignored",
              "uncertain"
            ]
          },
          "servesRequirementId": {
            "type": "string"
          },
          "testIntegrity": {
            "type": "object",
            "properties": {
              "loosened": {
                "type": "number",
                "minimum": 0
              },
              "factIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "loosened",
              "factIds"
            ],
            "additionalProperties": false
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "call": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "choice",
                    "score",
                    "noul"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "probabilities": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "calibratedValue": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "call",
                "question",
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "template": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "template",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "unitId",
          "role",
          "answers",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sentence": {
            "type": "string"
          },
          "requirementId": {
            "type": "string"
          },
          "claimsDone": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "claimsDeferred": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "sentence",
          "claimsDone",
          "claimsDeferred"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[A-Z0-9.]+(-[a-z_]+)?$"
          },
          "type": {
            "type": "string",
            "enum": [
              "requirement",
              "unit",
              "test_integrity",
              "fact",
              "ambiguity"
            ]
          },
          "targetId": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "route": {
            "type": "string",
            "enum": [
              "send_back",
              "ask_author",
              "reviewer_attention",
              "none"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "lines": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "file",
                "lines"
              ],
              "additionalProperties": false
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "template": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "template",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "contentKey": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "targetId",
          "priority",
          "route",
          "confidence",
          "locations",
          "reasons",
          "contentKey"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "counts": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "comment_only",
            "rework",
            "gate"
          ]
        },
        "gateDecision": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "refused"
          ]
        }
      },
      "required": [
        "counts",
        "mode"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "jevInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "llmInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "llmOutputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "jevInputTokens",
        "llmInputTokens",
        "llmOutputTokens",
        "costUsd",
        "latencyMs",
        "calls"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "input",
    "versions",
    "requirements",
    "units",
    "requirementVerdicts",
    "unitVerdicts",
    "claims",
    "findings",
    "summary",
    "usage",
    "warnings"
  ],
  "additionalProperties": false
}
