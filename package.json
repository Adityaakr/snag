{
  "name": "remit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:live": "REMIT_ALLOW_NETWORK=1 vitest run --config vitest.live.config.ts",
    "guard": "node scripts/guard.mjs",
    "progress": "node scripts/progress.mjs",
    "schemas": "tsx packages/core/src/contracts/write-schemas.ts",
    "remit": "tsx --conditions=source packages/cli/src/bin.ts",
    "fixtures:golden": "tsx --conditions=source scripts/fixtures/golden.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@remit/analysis": "workspace:*",
    "@remit/core": "workspace:*",
    "@remit/pipeline": "workspace:*",
    "@remit/providers": "workspace:*",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "diff": "9.0.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
