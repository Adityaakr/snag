  "summary": "HTTP retry helper: exponential capped backoff, retryable statuses, RetryExhausted, retry logging.",
  "requirements": [
    {
      "id": "R1",
      "text": "Delays between attempts start at `base_delay` and double each time, capped at `max_delay` (with a base of 0.5s: 0.5, 1, 2, 4)",
      "implementing": [
        {
          "file": "client/retry.py",
          "symbol": "backoff_delay"
        },
        {
          "file": "client/retry.py",
          "symbol": "call_with_retry",
          "replace": [
            {
              "from": "backoff_delay(attempt, settings[\"base_delay\"], settings[\"max_delay\"])",
              "to": "settings[\"base_delay\"]"
            }
          ]
        }
      ],
      "tests": [
        {
          "file": "tests/test_retry.py",
          "symbol": "test_backoff_doubles_each_attempt"
        },
        {
          "file": "tests/test_retry.py",
          "symbol": "test_backoff_is_capped"
        },
        {
          "file": "tests/test_retry.py",
          "symbol": "test_sleeps_grow_between_attempts"
        }
      ],
      "flip": {
