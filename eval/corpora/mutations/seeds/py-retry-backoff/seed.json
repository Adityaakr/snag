      "implementing": [
        {
          "file": "client/retry.py",
          "symbol": "is_retryable"
        },
        {
          "file": "client/retry.py",
          "symbol": "call_with_retry",
          "remove": [
            "if not is_retryable(error):"
          ]
        }
      ],
      "tests": [
        {
          "file": "tests/test_retry.py",
          "symbol": "test_retryable_statuses"
        },
        {
          "file": "tests/test_retry.py",
          "symbol": "test_other_statuses_are_not_retried"
        }
      ],
      "flip": {
        "impl": {
          "file": "client/retry.py",
          "symbol": "is_retryable",
